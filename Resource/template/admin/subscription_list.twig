{% extends '@admin/default_frame.twig' %}
{% set menus = ['order', 'univa_pay_subscriptions'] %}

{% block title %}{{ 'univa_pay.admin.subscriptions.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.order.order_management'|trans }}{% endblock %}

{% block main %}
{% set detailOpen = filters.status is not empty or filters.period or filters.date or filters.from or filters.to %}
<div class="c-outsideBlock">
    <form name="search_form" id="search_form" method="get" action="{{ path('univa_pay_admin_subscriptions') }}">
        <div class="c-outsideBlock__contents">
            <div class="row">
                <div class="col-12">
                    <div>
                        <label class="col-form-label" for="search_keyword">{{ 'univa_pay.admin.subscriptions.keyword'|trans }}</label>
                        <input type="text" class="form-control" id="search_keyword" name="keyword" value="{{ filters.keyword }}">
                    </div>
                    <div class="d-inline-block mb-3 mt-3{{ detailOpen ? '' : ' collapsed' }}" data-bs-toggle="collapse" href="#searchDetail" aria-expanded="{{ detailOpen ? 'true' : 'false' }}" aria-controls="searchDetail">
                        <a><i class="fa fw-bold me-1 {{ detailOpen ? 'fa-minus-square-o' : 'fa-plus-square-o' }}"></i><span class="fw-bold">{{ 'admin.common.search_detail'|trans }}</span></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-subContents ec-collapse collapse{{ detailOpen ? ' show' }}" id="searchDetail">
            <div class="row mb-2">
                <div class="col">
                    <p class="col-form-label">{{ 'univa_pay.admin.subscriptions.status'|trans }}</p>
                    {% for status in statuses %}
                        <div class="form-check form-check-inline">
                            <input type="checkbox" class="form-check-input" id="search_status_{{ status.id }}" name="status[]" value="{{ status.id }}"{{ status.id in filters.status ? ' checked' }}>
                            <label class="form-check-label" for="search_status_{{ status.id }}">{{ status.name }}</label>
                        </div>
                    {% endfor %}
                </div>
                <div class="col">
                    <label class="col-form-label">{{ 'univa_pay.admin.subscriptions.period'|trans }}</label>
                    <select class="form-select" name="period">
                        <option value="">{{ 'univa_pay.admin.subscriptions.all'|trans }}</option>
                        {% for period in periods|filter(p => p.id > 0) %}
                            <option value="{{ period.id }}"{{ filters.period == period.id ? ' selected' }}>{{ period.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col">
                    <label class="col-form-label">{{ 'univa_pay.admin.subscriptions.next'|trans }}</label>
                    <div class="row align-items-center">
                        <div class="col">
                            <input type="date" class="form-control" name="from" value="{{ filters.from }}">
                        </div>
                        <div class="col-auto text-center"><span>{{ 'admin.common.separator__range'|trans }}</span></div>
                        <div class="col">
                            <input type="date" class="form-control" name="to" value="{{ filters.to }}">
                        </div>
                    </div>
                </div>
                <div class="col">
                    <label class="col-form-label">{{ 'univa_pay.admin.subscriptions.date'|trans }}</label>
                    <div class="row">
                        <div class="col-6">
                            <input type="date" class="form-control" name="date" value="{{ filters.date }}">
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col">
                    <label class="col-form-label">{{ 'univa_pay.admin.subscriptions.sort'|trans }}</label>
                    <div class="row">
                        <div class="col">
                            <select class="form-select" name="sort">
                                {% for key in ['next', 'start', 'number'] %}
                                    <option value="{{ key }}"{{ filters.sort == key ? ' selected' }}>{{ ('univa_pay.admin.subscriptions.' ~ key)|trans }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col">
                            <select class="form-select" name="direction" aria-label="{{ 'univa_pay.admin.subscriptions.direction'|trans }}">
                                <option value="asc"{{ filters.direction == 'asc' ? ' selected' }}>ASC</option>
                                <option value="desc"{{ filters.direction == 'desc' ? ' selected' }}>DESC</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col"></div>
            </div>
        </div>
        <div class="c-outsideBlock__contents">
            <div class="row">
                <div class="mb-4">
                    <div class="col-12">
                        <button class="btn btn-ec-conversion px-5" type="submit" id="search_submit">{{ 'admin.common.search'|trans }}</button>
                        <a class="btn btn-ec-regular ms-2" href="{{ path('univa_pay_admin_subscriptions') }}">{{ 'univa_pay.admin.subscriptions.clear'|trans }}</a>
                        <span class="fw-bold ms-2" id="search_total_count">{{ 'admin.common.search_result'|trans({'%count%': pagination.totalItemCount})|raw }}</span>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="c-primaryCol">
            {% if pagination.totalItemCount > 0 %}
                <div class="card rounded border-0 mb-4 d-block">
                    <div class="card-body p-0">
                        <table class="table table-sm" id="search_result">
                            <thead>
                            <tr>
                                <th class="border-top-0 pt-2 pb-2 text-center ps-3">{{ 'univa_pay.admin.subscriptions.number'|trans }}</th>
                                <th class="border-top-0 pt-2 pb-2 text-center">{{ 'univa_pay.admin.subscriptions.customer'|trans }}</th>
                                <th class="border-top-0 pt-2 pb-2 text-center">{{ 'univa_pay.admin.subscriptions.products'|trans }}</th>
                                <th class="border-top-0 pt-2 pb-2 text-center">{{ 'univa_pay.admin.subscriptions.amount'|trans }}</th>
                                <th class="border-top-0 pt-2 pb-2 text-center">{{ 'univa_pay.admin.subscriptions.period'|trans }}</th>
                                <th class="border-top-0 pt-2 pb-2 text-center">{{ 'univa_pay.admin.subscriptions.status'|trans }}</th>
                                <th class="border-top-0 pt-2 pb-2 text-center">{{ 'univa_pay.admin.subscriptions.next'|trans }}</th>
                                <th class="border-top-0 pt-2 pb-2 text-center">{{ 'univa_pay.admin.subscriptions.last'|trans }}</th>
                                <th class="border-top-0 pt-2 pb-2 text-center">{{ 'univa_pay.admin.subscriptions.start'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for order in pagination %}
                                {% set displayedPeriod = periods|filter(p => p.id == order.univapaySubscriptionPeriod)|first %}
                                {% set lastStatus = latest[order.univapayParentSubscriptionId]|default(null) %}
                                <tr>
                                    <td class="align-middle text-start ps-3">
                                        <a class="action-edit" href="{{ path('admin_order_edit', {id: order.id}) }}">{{ order.order_no }}</a>
                                    </td>
                                    <td class="align-middle text-start">
                                        {% if order.Customer %}
                                            <a href="{{ path('admin_customer_edit', {id: order.Customer.id}) }}">{{ order.name01 }} {{ order.name02 }}</a>
                                        {% else %}
                                            {{ order.name01 }} {{ order.name02 }}
                                        {% endif %}
                                        <br>{{ order.email }}
                                    </td>
                                    <td class="align-middle text-start">
                                        {% for item in order.productOrderItems %}
                                            <div>{{ item.product_name }} × {{ item.quantity }}</div>
                                        {% endfor %}
                                    </td>
                                    <td class="align-middle text-end">{{ order.payment_total|price }}</td>
                                    <td class="align-middle text-center">{{ displayedPeriod ? displayedPeriod.name : '—' }}</td>
                                    <td class="align-middle text-center">{{ order.OrderStatus.name }}</td>
                                    <td class="align-middle text-center">{{ order.univapayNextChargeDate ? order.univapayNextChargeDate|date_day : '—' }}</td>
                                    <td class="align-middle text-center">{{ lastStatus ? lastStatus.name : '—' }}</td>
                                    <td class="align-middle text-center">{{ order.order_date|date_day }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="row justify-content-md-center pb-4 mb-4">
                        {% include '@admin/pager.twig' with {'pages': pagination.paginationData, 'routes': 'univa_pay_admin_subscriptions'} %}
                    </div>
                </div>
                <p class="text-muted">{{ 'univa_pay.admin.subscriptions.snapshot_note'|trans }}</p>
            {% else %}
                <div class="card rounded border-0">
                    <div class="card-body p-4">
                        <div class="text-center text-muted mb-4 h5">{{ 'admin.common.search_no_result'|trans }}</div>
                        <div class="text-center text-muted">{{ 'admin.common.search_try_change_condition'|trans }}</div>
                        <div class="text-center text-muted">{{ 'admin.common.search_try_advanced_search'|trans }}</div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
