{% extends '@admin/default_frame.twig' %}
{% set menus = ['order', 'univa_pay_subscriptions'] %}

{% block title %}{{ 'univa_pay.admin.subscriptions.title'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.order.order_management'|trans }}{% endblock %}

{% block main %}
<div class="c-outsideBlock">
    <form method="get" action="{{ path('univa_pay_admin_subscriptions') }}">
        <div class="c-outsideBlock__contents">
            <div class="row mb-3">
                <div class="col-md-3">
                    <label>{{ 'univa_pay.admin.subscriptions.keyword'|trans }}</label>
                    <input type="text" class="form-control"
                           name="keyword" value="{{ filters.keyword }}">
                </div>
                <div class="col-md-2">
                    <label>{{ 'univa_pay.admin.subscriptions.status'|trans }}</label>
                    <select class="form-control" name="status">
                        <option value="">{{ 'univa_pay.admin.subscriptions.all'|trans }}</option>
                        {% for status in statuses %}
                            <option value="{{ status.id }}"
                                {% if filters.status == status.id %}selected{% endif %}>
                                {{ status.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label>{{ 'univa_pay.admin.subscriptions.period'|trans }}</label>
                    <select class="form-control" name="period">
                        <option value="">{{ 'univa_pay.admin.subscriptions.all'|trans }}</option>
                        {% for period in periods %}
                            {% if period.id > 0 %}
                                <option value="{{ period.id }}"
                                    {% if filters.period == period.id %}selected{% endif %}>
                                    {{ period.name }}
                                </option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label>{{ 'univa_pay.admin.subscriptions.date'|trans }}</label>
                    <input type="date" class="form-control"
                           name="date" value="{{ filters.date }}">
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-2">
                    <label>{{ 'univa_pay.admin.subscriptions.from'|trans }}</label>
                    <input type="date" class="form-control"
                           name="from" value="{{ filters.from }}">
                </div>
                <div class="col-md-2">
                    <label>{{ 'univa_pay.admin.subscriptions.to'|trans }}</label>
                    <input type="date" class="form-control"
                           name="to" value="{{ filters.to }}">
                </div>
                <div class="col-md-2">
                    <label>{{ 'univa_pay.admin.subscriptions.sort'|trans }}</label>
                    <select class="form-control" name="sort">
                        <option value="next"
                            {% if filters.sort == 'next' %}selected{% endif %}>
                            {{ 'univa_pay.admin.subscriptions.next'|trans }}
                        </option>
                        <option value="start"
                            {% if filters.sort == 'start' %}selected{% endif %}>
                            {{ 'univa_pay.admin.subscriptions.start'|trans }}
                        </option>
                        <option value="number"
                            {% if filters.sort == 'number' %}selected{% endif %}>
                            {{ 'univa_pay.admin.subscriptions.number'|trans }}
                        </option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label>{{ 'univa_pay.admin.subscriptions.direction'|trans }}</label>
                    <select class="form-control" name="direction">
                        <option value="asc"
                            {% if filters.direction == 'asc' %}selected{% endif %}>ASC</option>
                        <option value="desc"
                            {% if filters.direction == 'desc' %}selected{% endif %}>DESC</option>
                    </select>
                </div>
                <div class="col-md-4 align-self-end">
                    <button type="submit" class="btn btn-ec-conversion">
                        {{ 'admin.common.search'|trans }}
                    </button>
                    <a class="btn btn-ec-regular"
                       href="{{ path('univa_pay_admin_subscriptions') }}">
                        {{ 'univa_pay.admin.subscriptions.clear'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="c-primaryCol">
            <div class="card rounded border-0">
                <div class="card-body p-3">
                    <p>
                        {{ 'admin.common.search_result'|trans({
                            '%count%': pagination.totalItemCount
                        }) }}
                    </p>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead>
                            <tr>
                                <th>{{ 'univa_pay.admin.subscriptions.number'|trans }}</th>
                                <th>{{ 'univa_pay.admin.subscriptions.customer'|trans }}</th>
                                <th>{{ 'univa_pay.admin.subscriptions.products'|trans }}</th>
                                <th>{{ 'univa_pay.admin.subscriptions.amount'|trans }}</th>
                                <th>{{ 'univa_pay.admin.subscriptions.period'|trans }}</th>
                                <th>{{ 'univa_pay.admin.subscriptions.status'|trans }}</th>
                                <th>{{ 'univa_pay.admin.subscriptions.next'|trans }}</th>
                                <th>{{ 'univa_pay.admin.subscriptions.last'|trans }}</th>
                                <th>{{ 'univa_pay.admin.subscriptions.start'|trans }}</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for order in pagination %}
                                <tr>
                                    <td>
                                        <a href="{{ path('admin_order_edit', {id: order.id}) }}">
                                            {{ order.order_no }}
                                        </a>
                                    </td>
                                    <td>
                                        {{ order.name01 }} {{ order.name02 }}
                                        <div>{{ order.email }}</div>
                                    </td>
                                    <td>
                                        {% for item in order.productOrderItems %}
                                            <div>
                                                {{ item.product_name }}
                                                × {{ item.quantity }}
                                            </div>
                                        {% endfor %}
                                    </td>
                                    <td>{{ order.payment_total|price }}</td>
                                    <td>
                                        {% set displayedPeriod = null %}
                                        {% for period in periods %}
                                            {% if period.id == order.univapaySubscriptionPeriod %}
                                                {% set displayedPeriod = period.name %}
                                            {% endif %}
                                        {% endfor %}
                                        {{ displayedPeriod ?: '—' }}
                                    </td>
                                    <td>{{ order.OrderStatus.name }}</td>
                                    <td>
                                        {{ order.univapayNextChargeDate
                                            ? order.univapayNextChargeDate|date('Y-m-d')
                                            : '—' }}
                                    </td>
                                    <td>
                                        {% set lastStatus = latest[
                                            order.univapayParentSubscriptionId
                                        ]|default(null) %}
                                        {{ lastStatus ? lastStatus.name : '—' }}
                                    </td>
                                    <td>{{ order.order_date|date('Y-m-d') }}</td>
                                    <td>
                                        <form method="post"
                                              action="{{ path(
                                                  'univa_pay_admin_subscription_refresh',
                                                  app.request.query.all|merge({id: order.id})
                                              ) }}">
                                            <input type="hidden"
                                                   name="{{ constant('Eccube\\Common\\Constant::TOKEN_NAME') }}"
                                                   value="{{ csrf_token(constant('Eccube\\Common\\Constant::TOKEN_NAME')) }}">
                                            <button class="btn btn-ec-regular btn-sm" type="submit">
                                                {{ 'univa_pay.admin.subscriptions.refresh'|trans }}
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="10">
                                        {{ 'admin.common.search_no_result'|trans }}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="row justify-content-md-center pb-4">
                        {% include '@admin/pager.twig' with {
                            'pages': pagination.paginationData,
                            'routes': 'univa_pay_admin_subscriptions'
                        } %}
                    </div>
                    <p class="text-muted">
                        {{ 'univa_pay.admin.subscriptions.snapshot_note'|trans }}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
