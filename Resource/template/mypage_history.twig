{% set isSubscriptionActive = Order.OrderStatus.getId() == constant('Plugin\\UnivaPay\\Entity\\Master\\UnivaPayOrderStatus::UNIVAPAY_SUBSCRIPTION_ACTIVE') %}
{% set customerPageUrl = UnivaPayCustomerPageUrl|default(null) %}
{% if isSubscriptionActive or customerPageUrl %}
    <div id="univapay-subscription">
        <div class="ec-rectHeading">
            <h2>サブスクリプション</h2>
        </div>
        {{ include('Shopping/alert.twig', { error_only: true }) }}
        <ul class="list-inline">
            {% if customerPageUrl %}
                <li class="list-inline-item">
                    <a href="{{ customerPageUrl }}" target="_blank" rel="noopener" class="ec-inlineBtn">
                        {{ 'univa_pay.mypage.subscription.customer_page'|trans }}
                    </a>
                </li>
            {% endif %}
            {% if isSubscriptionActive %}
                <li class="list-inline-item">
                    <a href="{{ url('univa_pay_cancel_subscription', { id: Order.id }) }}" {{ csrf_token_for_anchor() }}
                       data-method="put" data-message="{{ 'univa_pay.mypage.subscription.cancel.confirm'|trans }}"
                       class="ec-inlineBtn">
                        {{ 'univa_pay.subscription.cancel'|trans }}
                    </a>
                </li>
            {% endif %}
        </ul>
        {% if customerPageUrl %}
            <p>{{ 'univa_pay.mypage.subscription.customer_page.note'|trans }}</p>
        {% endif %}
    </div>
    <script>
        $(function () {
            // 支払情報の下にセクションを移動
            document.querySelector(".ec-orderPayment").after(document.querySelector("#univapay-subscription"));
        });
    </script>
{% endif %}
